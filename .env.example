# Administrator login for the new display computer.
#
# Usage:
#   1. Copy this file to `.env` on the machine that needs it:  cp .env.example .env
#   2. Fill in the real values in `.env`.
#   3. Never commit `.env` — it is git-ignored. Only this placeholder
#      template belongs in the repository.

DISPLAY_PC_ADMIN_USERNAME=
DISPLAY_PC_ADMIN_PASSWORD=
