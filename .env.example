# ---- Narayan configuration ----
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Anthropic API key (https://console.anthropic.com/) — used for message analysis.
ANTHROPIC_API_KEY=sk-ant-...

# Tiered models:
#   CLASSIFY_MODEL — cheap/fast model for per-batch triage (runs on every message batch).
#   DRAFT_MODEL    — capable model for drafting replies + the daily brief (low volume).
# Opus 4.8 is the draft tier today; switch DRAFT_MODEL to claude-fable-5 when available.
CLASSIFY_MODEL=claude-sonnet-4-6
DRAFT_MODEL=claude-opus-4-8

# Reasoning effort per stage: low | medium | high | xhigh | max
CLASSIFY_EFFORT=medium
DRAFT_EFFORT=xhigh
BRIEF_EFFORT=xhigh

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your personal Telegram chat id (numeric). Get it from @userinfobot.
# Only this chat may control the bot and receive reminders.
TELEGRAM_CHAT_ID=123456789

# Folder where Baileys stores WhatsApp auth state (gitignored).
AUTH_DIR=./auth_state

# SQLite database file path (gitignored).
DB_PATH=./data/narayan.db

# Path to your local config.json (allowlist, reminder times, persona, priority bands).
CONFIG_PATH=./config.json

# Optional: absolute path to an Obsidian vault folder for markdown export.
# Leave empty to disable Obsidian export.
OBSIDIAN_VAULT_PATH=

# Optional: path to your knowledge.md (personnel, projects, disputes, fleet, receivables).
# Injected into analysis so drafts/brief are grounded in your operation. Leave empty to disable.
KNOWLEDGE_PATH=./knowledge.md
